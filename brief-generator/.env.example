# ─────────────────────────────────────────────────────────────
# Generador de Brief de Clientes — variables de entorno
# Copiar a .env.local y completar. Nunca subir .env.local al repo.
# ─────────────────────────────────────────────────────────────

# URL pública de la app (se usa para armar los enlaces que se envían al cliente).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ────────────────────────────────────────────────
# Si estas tres variables están vacías, la app arranca en MODO DEMO:
# los datos viven en un archivo local (.data/demo.json) y no se necesita
# ninguna cuenta externa. Sirve para probar el sistema completo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave de servicio: sólo servidor. No exponer nunca al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Bucket de Storage para los archivos que sube el cliente.
SUPABASE_STORAGE_BUCKET=brief-adjuntos

# ── Acceso del administrador en modo demo ───────────────────
# Con Supabase configurado, el ingreso es con Supabase Auth y esto se ignora.
ADMIN_DEMO_EMAIL=admin@agencia.cl
ADMIN_DEMO_PASSWORD=demo1234

# Secreto para firmar la cookie de sesión del administrador en modo demo.
ADMIN_SESSION_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
